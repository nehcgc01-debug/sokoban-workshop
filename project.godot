config_version=5

[application]
config/name="Kuro_sukobann"
run/main_scene="res://main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
GameState="*res://game_state.gd"
AudioService="*res://audio_service.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.085, 1)

[gui]
theme/custom="res://theme.tres"
